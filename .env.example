# Copier ce fichier vers .env et remplir les valeurs avant de lancer docker-compose

# URL de l'API telle que VUE DEPUIS TON NAVIGATEUR (pas depuis l'intérieur de
# Docker) — utilise l'adresse IP ou le nom de domaine réel du serveur, et le
# port choisi ci-dessus pour API_HOST_PORT. "localhost" ne fonctionne PAS ici
# si tu accèdes au site depuis un autre appareil que le serveur lui-même.
VITE_API_URL=http://192.168.0.63:3080

# Ports exposés à l'hôte — à ajuster si un port est déjà pris par un autre
# service Docker sur ton NAS. Le port interne aux conteneurs ne change pas.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
API_HOST_PORT=3000
WEB_HOST_PORT=5173

# PostgreSQL
POSTGRES_DB=mon511
POSTGRES_USER=mon511
POSTGRES_PASSWORD=change_moi

# MinIO
MINIO_ROOT_USER=mon511
MINIO_ROOT_PASSWORD=change_moi_aussi

# API
NODE_ENV=development
JWT_SECRET=change_moi_encore

# Cartes (MapTiler ou équivalent — voir discussion stack technique)
MAPTILER_API_KEY=

# Courriel (ex. Resend, Postmark, ou SMTP self-hosté)
# Laisser SMTP_HOST vide pour l'instant : les courriels seront simplement
# journalisés dans les logs de l'API plutôt que d'échouer.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=notifications@mon511.ca
